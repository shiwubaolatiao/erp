# LMG ERP v2 环境变量（复制为 .env 并填写）
# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=
DB_NAME=lmg_erp
LEGACY_DB_NAME=lmg_platform

# ===== JWT =====
# 必填：请显式设置为本环境专属随机长字符串（例如 python -c "import secrets;print(secrets.token_urlsafe(48))"）。
# 留空将拒绝启动（fail-fast），不要使用公开占位值。
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# ===== 上传 =====
MAX_UPLOAD_FILES=30

# ===== AI =====
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/anthropic
AI_MODEL=deepseek-v4-pro
AI_PROVIDER=anthropic
AI_MAX_TOKENS=100000
AI_THINKING_BUDGET=80000

ADS_MEMORY_ROUNDS=40
ADS_REPORTS_ROOT=D:\path\to\ads_reports
